{
  "opencollection": "1.0.0",
  "info": {
    "name": "WellSaid Labs Clips Voices API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Api-Key",
      "value": "{{X-Api-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Voices",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get available voice avatars.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.wellsaidlabs.com/v1/tts/avatars"
          },
          "docs": "Returns the list of available voice avatars with their speaker_id, name, accent, and speaking style for selecting a voice to render with."
        }
      ]
    }
  ],
  "bundled": true
}